# Cloudflare Pages headers. Versioned assets (?v=) can be cached for a year;
# apply_chrome.py bumps CSS_VERSION whenever site.css or analytics.js change.
/site.css
  Cache-Control: public, max-age=31536000, immutable
/analytics.js
  Cache-Control: public, max-age=31536000, immutable
/site.js
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
/zones/*
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=604800

# Article figures are reused by Medium, Substack and anyone embedding them
/img/articles/*
  Access-Control-Allow-Origin: *

# The installable app. The worker must never be served stale, or a fix to it
# takes a day to reach anyone; the manifest changes rarely.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=604800
