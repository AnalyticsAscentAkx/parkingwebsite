# Postgres. Matches docker-compose.yml defaults (host port 5433).
EVLAYER_DSN=postgresql://evlayer:evlayer@localhost:5433/evlayer

# Availability poll cadence in seconds. Spec default 300 (5 min).
# Only used when a scheduler is wired up; the CLI commands are one-shot.
POLL_SECONDS=300

# Where generated SEO pages are written (relative to scripts/ev/).
SITE_ROOT=../..

# Optional Socrata app token. Raises the RDW rate limit; not required.
RDW_APP_TOKEN=

# Only index a station page once it has this many days of history (spec 6.1).
MIN_HISTORY_DAYS=30
